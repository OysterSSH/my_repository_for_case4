<mvc:View controllerName="finprecheck.controller.fin-precheck"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table">
    <Page id="page" title="Financial Month-End Pre-Check" class="sapUiNoContentPadding">
        <content>
            <!-- 使用VBox替代Grid，移除左右留白 -->
            <VBox width="100%">
                <items>
                    <!-- 查询工具栏 -->
                    <Panel class="sapUiNoMargin" expandable="false" width="100%">
                        <headerToolbar>
                            <Toolbar>
                                <Title text="Query Conditions" level="H3" />
                            </Toolbar>
                        </headerToolbar>
                        <content>
                            <HBox alignItems="Center" wrap="Wrap" class="sapUiMediumMargin" justifyContent="SpaceBetween">
                                <!-- 左侧控件组 -->
                                <HBox alignItems="Center" wrap="Wrap">
                                    <!-- 公司代码 -->
                                    <HBox alignItems="Center" class="sapUiSmallMarginEnd">
                                        <Label text="Company Code" required="true" class="sapUiSmallMarginEnd" />
                                        <ComboBox id="companyCodeInput" 
                                                width="14rem"
                                                items="{view>/CompanyCodes}" 
                                                placeholder="Please select company code"
                                                selectionChange="onCompanyCodeChange">
                                            <core:Item key="{view>key}" text="{view>text}" />
                                        </ComboBox>
                                    </HBox>
                                    
                                    <!-- Plant Code -->
                                    <HBox alignItems="Center" class="sapUiSmallMarginEnd">
                                        <Label text="Plant Code" required="true" class="sapUiSmallMarginEnd" />
                                        <ComboBox id="plantInput" 
                                                width="14rem"
                                                items="{view>/Plants}" 
                                                placeholder="Please select plant code"
                                                selectionChange="onPlantChange">
                                            <core:Item key="{view>key}" text="{view>text}" />
                                        </ComboBox>
                                    </HBox>
                                    
                                    <!-- Year/Month -->
                                    <HBox alignItems="Center" class="sapUiSmallMarginEnd">
                                        <Label text="Year/Month" required="true" class="sapUiSmallMarginEnd" />
                                        <DatePicker id="postingTimePicker" 
                                                    width="12rem"
                                                    value="2025.10" 
                                                    displayFormat="yyyy.MM" 
                                                    valueFormat="yyyy.MM" />
                                    </HBox>
                                </HBox>
                                
                                <!-- 右侧按钮组 -->
                                <HBox class="sapUiSmallMarginStart">
                                    <Button id="precheckButton"
                                            text="AI Pre-Check" 
                                            press="onPrecheck" 
                                            type="Emphasized"
                                            icon="sap-icon://activate"
                                            class="sapUiTinyMarginEnd" />
                                    <Button text="Reset" 
                                            press="onReset" 
                                            icon="sap-icon://clear-all" />
                                </HBox>
                            </HBox>
                        </content>
                    </Panel>

                    <!-- 表格工具栏 -->
                    <Panel class="sapUiNoMargin sapUiMediumMarginTop" expandable="false" height="600px" width="100%">
                        <headerToolbar>
                            <Toolbar>
                                <Title text="Check Results" level="H3" />
                                <Text text="({= ${view>/CheckResults}.length || 0} records)" class="sapUiTinyMarginBegin" />
                                <ToolbarSpacer />
                                
                                <!-- 表格功能按钮 -->
                                <SearchField width="15rem" 
                                             placeholder="Search..."
                                             search="onSearch"
                                             liveChange="onLiveSearch" />
                                <Button icon="sap-icon://filter" 
                                        press="onOpenFilterDialog" 
                                        tooltip="Advanced Filter"
                                        class="sapUiTinyMarginBegin" />
                                <MenuButton icon="sap-icon://action-settings" 
                                           tooltip="Table Settings"
                                           class="sapUiTinyMarginBegin">
                                    <menu>
                                        <Menu>
                                            <MenuItem text="Show/Hide Columns" 
                                                     icon="sap-icon://show" 
                                                     press="onOpenColumnDialog" />
                                            <MenuItem text="Reset Column Width" 
                                                     icon="sap-icon://refresh" 
                                                     press="onResetColumnWidth" />
                                            <MenuItem text="Export to Excel" 
                                                     icon="sap-icon://excel-attachment" 
                                                     press="onExportToExcel" />
                                            <MenuItem text="Save View" 
                                                     icon="sap-icon://save" 
                                                     press="onSaveTableView" />
                                        </Menu>
                                    </menu>
                                </MenuButton>
                            </Toolbar>
                        </headerToolbar>
                        
                        <content>
                            <table:Table id="precheckTable"
                                        rows="{view>/CheckResults}"
                                        selectionMode="Single"
                                        selectionBehavior="Row"
                                        visibleRowCountMode="Auto"
                                        minAutoRowCount="5"
                                        enableColumnReordering="true"
                                        enableColumnFreeze="true"
                                        columnHeaderHeight="40"
                                        rowHeight="60"
                                        alternateRowColors="true"
                                        class="sapUiSizeCompact"
                                        width="100%">
                                <!-- 颜色标记列
                                <table:rowSettingsTemplate>
                                    <table:RowSettings highlight="{path: 'view>alertType', formatter: '.formatRowHighlightColor'}" />
                                </table:rowSettingsTemplate> -->
                                <table:columns>
                                    <!-- ID Column -->
                                    <table:Column id="idColumn" width="70px" resizable="true" sortProperty="ID" filterProperty="ID" hAlign="Center">
                                        <table:label><Label text="ID" /></table:label>
                                        <table:template><Text text="{view>ID}" wrapping="false" /></table:template>
                                    </table:Column>
                                    
                                    <!-- Alert Type Column -->
                                    <table:Column id="alertTypeColumn" width="120px" resizable="true" sortProperty="alertType" filterProperty="alertType" hAlign="Center">
                                        <table:label><Label text="Alert Type" /></table:label>
                                        <table:template>
                                            <HBox alignItems="Center">
                                                <core:Icon src="{path: 'view>alertType', formatter: '.formatAlertIcon'}" 
                                                        color="{path: 'view>alertType', formatter: '.formatAlertColor'}"
                                                        class="sapUiTinyMarginEnd" />
                                                <Text text="{path: 'view>alertType', formatter: '.formatAlertText'}" />
                                            </HBox>
                                        </table:template>
                                    </table:Column>
                                    
                                    <!-- Check Item Column -->
                                    <table:Column id="checkItemColumn" width="200px" resizable="true" sortProperty="checkItem" filterProperty="checkItem" hAlign="Center">
                                        <table:label><Label text="Check Item" /></table:label>
                                        <table:template><Text text="{view>checkItem}" wrapping="true" /></table:template>
                                    </table:Column>
                                    
                                    <!-- Check Result Column -->
                                    <table:Column id="checkResultColumn" width="300px" resizable="true" sortProperty="checkResult" filterProperty="checkResult" hAlign="Center">
                                        <table:label><Label text="Check Result" /></table:label>
                                        <table:template><Text text="{view>checkResult}" wrapping="true" maxLines="3" /></table:template>
                                    </table:Column>
                                    
                                    <!-- AI Suggested Action Column -->
                                    <table:Column id="suggestedActionColumn" width="300px" resizable="true" sortProperty="suggestedAction" filterProperty="suggestedAction" hAlign="Center">
                                        <table:label><Label text="AI Suggested Action" /></table:label>
                                        <table:template><Text text="{view>suggestedAction}" wrapping="true" maxLines="3" /></table:template>
                                    </table:Column>
                                    
                                    <!-- AI Description Column -->
                                    <table:Column id="suggestionColumn" width="130px" resizable="true" hAlign="Center">
                                        <table:label><Label text="AI Description" /></table:label>
                                        <table:template>
                                            <Button text="AI Analysis" 
                                                    icon="sap-icon://discussion-2"
                                                    type="Ghost"
                                                    press="onAIAnalysisPress" />
                                        </table:template>
                                    </table:Column>
                                    
                                    <!-- Operation Column -->
                                    <table:Column width="110px" resizable="true" sortProperty="isAgent" filterProperty="isAgent" hAlign="Center">
                                        <table:label><Label text="Operation" /></table:label>
                                        <table:template>
                                            <HBox alignItems="Center" justifyContent="Center">
                                                <Button visible="{= ${view>isAgent} === '是'}"
                                                        icon="sap-icon://product"
                                                        type="Default"
                                                        tooltip="Execute AI Agent"
                                                        press="onExecuteAgent"
                                                        class="diamondButton" />
                                                
                                                <Button visible="{= ${view>isAgent} !== '是'}"
                                                        icon="sap-icon://navigation-right-arrow"
                                                        type="Default"
                                                        tooltip="View Details"
                                                        press="onNavigateToDetail"
                                                        class="arrowButton" />
                                            </HBox>
                                        </table:template>
                                    </table:Column>
                                </table:columns>
                                
                                <!-- 无数据显示 -->
                                <table:noData>
                                    <IllustratedMessage 
                                        illustrationType="sapIllus-EmptyList"
                                        title="No Data"
                                        description="Please enter query conditions and click the pre-check button to get check results" />
                                </table:noData>
                            </table:Table>
                        </content>
                    </Panel>
                </items>
            </VBox>
        </content>    
    </Page>
</mvc:View>
