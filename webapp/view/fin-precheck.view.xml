<mvc:View controllerName="finprecheck.controller.fin-precheck"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table">
    <Page id="page" title="财务月结预检查">
        <content>
            <!-- 调整Grid配置，减少右侧留白 -->
            <l:Grid defaultSpan="XL12 L12 M12 S12" width="100%">
                <l:content>
                    <!-- 查询工具栏 -->
                    <Panel class="sapUiNoMargin" expandable="false" width="100%">
                        <headerToolbar>
                            <Toolbar>
                                <Title text="查询条件" level="H3" />
                            </Toolbar>
                        </headerToolbar>
                        <content>
                            <HBox alignItems="Center" wrap="Wrap" class="sapUiMediumMargin" justifyContent="SpaceBetween">
                                <!-- 左侧控件组 -->
                                <HBox alignItems="Center" wrap="Wrap">
                                    <!-- 公司代码 -->
                                    <HBox alignItems="Center" class="sapUiSmallMarginEnd">
                                        <Label text="公司代码" required="true" class="sapUiSmallMarginEnd" />
                                        <ComboBox id="companyCodeInput" 
                                                width="14rem"
                                                items="{view>/CompanyCodes}" 
                                                placeholder="请选择公司代码"
                                                selectionChange="onCompanyCodeChange">
                                            <core:Item key="{view>key}" text="{view>text}" />
                                        </ComboBox>
                                    </HBox>
                                    
                                    <!-- 工厂代码 -->
                                    <HBox alignItems="Center" class="sapUiSmallMarginEnd">
                                        <Label text="工厂代码" required="true" class="sapUiSmallMarginEnd" />
                                        <ComboBox id="plantInput" 
                                                width="14rem"
                                                items="{view>/Plants}" 
                                                placeholder="请选择工厂代码"
                                                selectionChange="onPlantChange">
                                            <core:Item key="{view>key}" text="{view>text}" />
                                        </ComboBox>
                                    </HBox>
                                    
                                    <!-- 年月 -->
                                    <HBox alignItems="Center" class="sapUiSmallMarginEnd">
                                        <Label text="年月" required="true" class="sapUiSmallMarginEnd" />
                                        <DatePicker id="postingTimePicker" 
                                                    width="12rem"
                                                    value="2025.10" 
                                                    displayFormat="yyyy.MM" 
                                                    valueFormat="yyyy.MM" />
                                    </HBox>
                                </HBox>
                                
                                <!-- 右侧按钮组 -->
                                <HBox class="sapUiSmallMarginStart">
                                    <Button id="precheckButton"
                                            text="AI预检查" 
                                            press="onPrecheck" 
                                            type="Emphasized"
                                            icon="sap-icon://activate"
                                            class="sapUiTinyMarginEnd" />
                                    <Button text="重置" 
                                            press="onReset" 
                                            icon="sap-icon://clear-all" />
                                </HBox>
                            </HBox>
                        </content>
                    </Panel>

                    <!-- 表格工具栏 -->
                    <Panel class="sapUiNoMargin sapUiMediumMarginTop" expandable="false" height="600px" width="100%">
                        <headerToolbar>
                            <Toolbar>
                                <Title text="检查结果" level="H3" />
                                <Text text="({= ${view>/CheckResults}.length || 0} 条记录)" class="sapUiTinyMarginBegin" />
                                <ToolbarSpacer />
                                
                                <!-- 表格功能按钮 -->
                                <SearchField width="15rem" 
                                             placeholder="搜索..."
                                             search="onSearch"
                                             liveChange="onLiveSearch" />
                                <Button icon="sap-icon://filter" 
                                        press="onOpenFilterDialog" 
                                        tooltip="高级筛选"
                                        class="sapUiTinyMarginBegin" />
                                <MenuButton icon="sap-icon://action-settings" 
                                           tooltip="表格设置"
                                           class="sapUiTinyMarginBegin">
                                    <menu>
                                        <Menu>
                                            <MenuItem text="显示/隐藏列" 
                                                     icon="sap-icon://show" 
                                                     press="onOpenColumnDialog" />
                                            <MenuItem text="重置列宽" 
                                                     icon="sap-icon://refresh" 
                                                     press="onResetColumnWidth" />
                                            <MenuItem text="导出Excel" 
                                                     icon="sap-icon://excel-attachment" 
                                                     press="onExportToExcel" />
                                            <MenuItem text="保存视图" 
                                                     icon="sap-icon://save" 
                                                     press="onSaveTableView" />
                                        </Menu>
                                    </menu>
                                </MenuButton>
                            </Toolbar>
                        </headerToolbar>
                        
                        <content>
                            <table:Table id="precheckTable"
                                        rows="{view>/CheckResults}"
                                        selectionMode="Single"
                                        selectionBehavior="Row"
                                        visibleRowCountMode="Auto"
                                        minAutoRowCount="5"
                                        enableColumnReordering="true"
                                        enableColumnFreeze="true"
                                        columnHeaderHeight="40"
                                        rowHeight="60"
                                        alternateRowColors="true"
                                        class="sapUiSizeCompact"
                                        width="100%">
                                <!-- 颜色标记列
                                <table:rowSettingsTemplate>
                                    <table:RowSettings highlight="{path: 'view>alertType', formatter: '.formatRowHighlightColor'}" />
                                </table:rowSettingsTemplate> -->
                                <table:columns>
                                    <!-- ID列 -->
                                    <table:Column id="idColumn" width="80px" resizable="true" sortProperty="ID" filterProperty="ID" hAlign="Center">
                                        <table:label><Label text="ID" /></table:label>
                                        <table:template><Text text="{view>ID}" wrapping="false" /></table:template>
                                    </table:Column>
                                    
                                    <!-- 提醒方式列 -->
                                    <table:Column id="alertTypeColumn" width="120px" resizable="true" sortProperty="alertType" filterProperty="alertType" hAlign="Center">
                                        <table:label><Label text="提醒方式" /></table:label>
                                        <table:template>
                                            <HBox alignItems="Center">
                                                <core:Icon src="{path: 'view>alertType', formatter: '.formatAlertIcon'}" 
                                                        color="{path: 'view>alertType', formatter: '.formatAlertColor'}"
                                                        class="sapUiTinyMarginEnd" />
                                                <Text text="{path: 'view>alertType', formatter: '.formatAlertText'}" />
                                            </HBox>
                                        </table:template>
                                    </table:Column>
                                    
                                    <!-- 检查项列 -->
                                    <table:Column id="checkItemColumn" width="220px" resizable="true" sortProperty="checkItem" filterProperty="checkItem" hAlign="Center">
                                        <table:label><Label text="检查项" /></table:label>
                                        <table:template><Text text="{view>checkItem}" wrapping="true" /></table:template>
                                    </table:Column>
                                    
                                    <!-- 检查结果列 -->
                                    <table:Column id="checkResultColumn" width="350px" resizable="true" sortProperty="checkResult" filterProperty="checkResult" hAlign="Center">
                                        <table:label><Label text="检查结果" /></table:label>
                                        <table:template><Text text="{view>checkResult}" wrapping="true" maxLines="3" /></table:template>
                                    </table:Column>
                                    
                                    <!-- AI建议列 -->
                                    <table:Column id="suggestedActionColumn" width="350px" resizable="true" sortProperty="suggestedAction" filterProperty="suggestedAction" hAlign="Center">
                                        <table:label><Label text="AI建议处理方案" /></table:label>
                                        <table:template><Text text="{view>suggestedAction}" wrapping="true" maxLines="3" /></table:template>
                                    </table:Column>
                                    
                                    <!-- AI说明列 -->
                                    <table:Column id="suggestionColumn" width="120px" resizable="true" hAlign="Center">
                                        <table:label><Label text="AI说明" /></table:label>
                                        <table:template>
                                            <Button text="AI分析" 
                                                    icon="sap-icon://discussion-2"
                                                    type="Ghost"
                                                    press="onAIAnalysisPress" />
                                        </table:template>
                                    </table:Column>
                                    
                                    <!-- 执行Agent列 -->
                                    <table:Column width="120px" resizable="true" sortProperty="isAgent" filterProperty="isAgent" hAlign="Center">
                                        <table:label><Label text="操作" /></table:label>
                                        <table:template>
                                            <HBox alignItems="Center" justifyContent="Center">
                                                <Button visible="{= ${view>isAgent} === '是'}"
                                                        icon="sap-icon://product"
                                                        type="Default"
                                                        tooltip="执行AI Agent"
                                                        press="onExecuteAgent"
                                                        class="diamondButton" />
                                                
                                                <Button visible="{= ${view>isAgent} !== '是'}"
                                                        icon="sap-icon://navigation-right-arrow"
                                                        type="Default"
                                                        tooltip="查看详情"
                                                        press="onNavigateToDetail"
                                                        class="arrowButton" />
                                            </HBox>
                                        </table:template>
                                    </table:Column>
                                </table:columns>
                                
                                <!-- 无数据显示 -->
                                <table:noData>
                                    <IllustratedMessage 
                                        illustrationType="sapIllus-EmptyList"
                                        title="暂无数据"
                                        description="请输入查询条件并点击预检查按钮获取检查结果" />
                                </table:noData>
                            </table:Table>
                        </content>
                    </Panel>
                </l:content>
            </l:Grid>
        </content>    
    </Page>
</mvc:View>
