<mvc:View controllerName="finprecheck.controller.FixedAssetDepreciationList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table">
    <Page id="FixedAssetDepreciationPage" title="Fixed Asset Depreciation Check - Asset List" showNavButton="true" navButtonPress="onNavBack">
        <content>
            <!-- Adjust Grid configuration to reduce right margin -->
            <l:Grid defaultSpan="XL12 L12 M12 S12" 
                    containerQuery="true" 
                    width="100%">
                <l:content>
                    <!-- Query Toolbar -->
                    <Panel class="sapUiNoMargin" expandable="false" width="100%">
                        <headerToolbar>
                            <Toolbar>
                                <Title text="Query Conditions" level="H3" />
                            </Toolbar>
                        </headerToolbar>
                        <content>
                            <HBox alignItems="Center" wrap="Wrap" class="sapUiMediumMargin" justifyContent="SpaceBetween">
                                <!-- Left Control Group -->
                                <HBox alignItems="Center" wrap="Wrap">
                                    <!-- Posting Date Month -->
                                    <HBox alignItems="Center" class="sapUiSmallMarginEnd">
                                        <Label text="Posting Date Month" required="true" class="sapUiSmallMarginEnd" />
                                        <DatePicker id="monthPicker" 
                                                    width="12rem"
                                                    displayFormat="yyyy-MM" 
                                                    valueFormat="yyyy-MM"
                                                    value="2025-10"
                                                    placeholder="Select Month" />
                                    </HBox>
                                </HBox>
                                
                                <!-- Right Button Group -->
                                <HBox class="sapUiSmallMarginStart">
                                    <Button text="Query" 
                                            press="onSearch" 
                                            type="Emphasized"
                                            icon="sap-icon://search"
                                            class="sapUiTinyMarginEnd" />
                                    <Button text="Export to Excel" 
                                            press="onExport" 
                                            type="Default"
                                            icon="sap-icon://excel-attachment"
                                            class="sapUiTinyMarginEnd" />
                                    <MenuButton text="Communication"
                                                type="Default"
                                                icon="sap-icon://discussion-2"
                                                buttonMode="Split"
                                                defaultAction="onCommunicationDefault">
                                        <menu>
                                            <Menu>
                                                <MenuItem text="Add Comment" 
                                                         icon="sap-icon://comment" 
                                                         press="onAddComment"/>
                                                <MenuItem text="Send Notification" 
                                                         icon="sap-icon://notification" 
                                                         press="onSendNotification"/>
                                                <MenuItem text="Send Email" 
                                                         icon="sap-icon://email" 
                                                         press="onSendEmail"/>
                                                <MenuItem text="Mark as Completed" 
                                                         icon="sap-icon://accept" 
                                                         press="onMarkCompleted"/>
                                            </Menu>
                                        </menu>
                                    </MenuButton>
                                </HBox>
                            </HBox>
                        </content>
                    </Panel>

                    <!-- Table Toolbar -->
                    <Panel class="sapUiNoMargin sapUiMediumMarginTop" expandable="false" height="600px" width="100%">
                        <headerToolbar>
                            <Toolbar>
                                <Title text="Fixed Asset List" level="H3" />
                                <Text text="({= ${view>/FixedAssetData}.length || 0} records)" class="sapUiTinyMarginBegin" />
                                <ToolbarSpacer />
                                
                                <!-- Table Function Buttons -->
                                <SearchField width="15rem" 
                                             placeholder="Search..."
                                             search="onTableSearch"
                                             liveChange="onTableLiveSearch" />
                                <Button icon="sap-icon://filter" 
                                        press="onOpenFilterDialog" 
                                        tooltip="Advanced Filter"
                                        class="sapUiTinyMarginBegin" />
                                <MenuButton icon="sap-icon://action-settings" 
                                           tooltip="Table Settings"
                                           class="sapUiTinyMarginBegin">
                                    <menu>
                                        <Menu>
                                            <MenuItem text="Show/Hide Columns" 
                                                     icon="sap-icon://show" 
                                                     press="onOpenColumnDialog" />
                                            <MenuItem text="Reset Column Width" 
                                                     icon="sap-icon://refresh" 
                                                     press="onResetColumnWidth" />
                                            <MenuItem text="Export to Excel" 
                                                     icon="sap-icon://excel-attachment" 
                                                     press="onExportToExcel" />
                                            <MenuItem text="Save View" 
                                                     icon="sap-icon://save" 
                                                     press="onSaveTableView" />
                                        </Menu>
                                    </menu>
                                </MenuButton>
                            </Toolbar>
                        </headerToolbar>
                        
                        <content>
                            <table:Table id="fixedAssetTable"
                                        rows="{view>/FixedAssetData}"
                                        selectionMode="MultiSelect"
                                        visibleRowCountMode="Auto"
                                        minAutoRowCount="5"
                                        enableColumnReordering="true"
                                        enableColumnFreeze="true"
                                        columnHeaderHeight="40"
                                        rowHeight="50"
                                        alternateRowColors="true"
                                        class="sapUiSizeCompact"
                                        width="100%"
                                        rowSelectionChange="onSelectionChange">
                                
                                <table:columns>
                                    <!-- Index Column -->
                                    <table:Column id="indexColumn" width="80px" resizable="true">
                                        <table:label><Label text="Index" /></table:label>
                                        <table:template><Text text="{view>index}" wrapping="false" /></table:template>
                                    </table:Column>
                                    
                                    <!-- Asset Number Column -->
                                    <table:Column id="assetNumberColumn" width="120px" resizable="true" sortProperty="assetNumber" filterProperty="assetNumber">
                                        <table:label><Label text="Asset Number" /></table:label>
                                        <table:template><Text text="{view>assetNumber}" wrapping="false" /></table:template>
                                    </table:Column>
                                    
                                    <!-- Asset Description Column -->
                                    <table:Column id="assetDescColumn" width="250px" resizable="true" sortProperty="assetDescription" filterProperty="assetDescription">
                                        <table:label><Label text="Asset Description" /></table:label>
                                        <table:template><Text text="{view>assetDescription}" wrapping="true" maxLines="2" /></table:template>
                                    </table:Column>
                                    
                                    <!-- Acquisition Date Column -->
                                    <table:Column id="acquisitionDateColumn" width="130px" resizable="true" sortProperty="acquisitionDate" filterProperty="acquisitionDate">
                                        <table:label><Label text="Acquisition Date" /></table:label>
                                        <table:template><Text text="{view>acquisitionDate}" wrapping="false" /></table:template>
                                    </table:Column>
                                    
                                    <!-- Acquisition Value Column -->
                                    <table:Column id="acquisitionValueColumn" width="150px" resizable="true" sortProperty="acquisitionValue" filterProperty="acquisitionValue">
                                        <table:label><Label text="Acquisition Value" /></table:label>
                                        <table:template><Text text="{view>acquisitionValue}" wrapping="false" /></table:template>
                                    </table:Column>
                                    
                                    <!-- Accumulated Depreciation Column -->
                                    <table:Column id="accDepreciationColumn" width="180px" resizable="true" sortProperty="accumulatedDepreciation" filterProperty="accumulatedDepreciation">
                                        <table:label><Label text="Accumulated Depreciation" /></table:label>
                                        <table:template><Text text="{view>accumulatedDepreciation}" wrapping="false" /></table:template>
                                    </table:Column>
                                    
                                    <!-- Last Depreciation Date Column -->
                                    <table:Column id="lastDepDateColumn" width="160px" resizable="true" sortProperty="lastDepreciationDate" filterProperty="lastDepreciationDate">
                                        <table:label><Label text="Last Depreciation Date" /></table:label>
                                        <table:template><Text text="{view>lastDepreciationDate}" wrapping="false" /></table:template>
                                    </table:Column>
                                    
                                    <!-- Error Description Column -->
                                    <table:Column id="errorDescColumn" width="250px" resizable="true" sortProperty="errorDesc" filterProperty="errorDesc">
                                        <table:label><Label text="Error Description" /></table:label>
                                        <table:template><Text text="{view>errorDesc}" wrapping="true" maxLines="3" /></table:template>
                                    </table:Column>
                                    
                                    <!-- AI Suggestion Column -->
                                    <table:Column id="aiSuggestionColumn" width="300px" resizable="true" sortProperty="aiSuggestion" filterProperty="aiSuggestion">
                                        <table:label><Label text="AI Suggestion" /></table:label>
                                        <table:template><Text text="{view>aiSuggestion}" wrapping="true" maxLines="3" /></table:template>
                                    </table:Column>
                                </table:columns>
                                
                                <!-- No Data Display -->
                                <table:noData>
                                    <IllustratedMessage 
                                        illustrationType="sapIllus-EmptyList"
                                        title="No Data"
                                        description="Please select query conditions and click the query button to get fixed asset depreciation data" />
                                </table:noData>
                            </table:Table>
                        </content>
                    </Panel>
                </l:content>
            </l:Grid>
        </content>
    </Page>

    <!-- Send Notification Dialog -->
    <Dialog id="sendNotificationDialog" 
        title="Send Notification" 
        draggable="true" 
        resizable="true"
        contentWidth="500px"
        contentHeight="400px">
        <content>
            <VBox class="sapUiMediumMargin">
                <!-- Due Date -->
                <Label text="Due Date:" required="true" class="sapUiTinyMarginBottom"/>
                <DatePicker id="dueDatePicker" 
                    displayFormat="yyyy.MM.dd" 
                    valueFormat="yyyy.MM.dd"
                    placeholder="Select due date"
                    width="100%"
                    class="sapUiMediumMarginBottom"
                    change="onDueDateChange"/>
                
                <!-- Recipient -->
                <Label text="Recipient:" required="true" class="sapUiTinyMarginBottom"/>
                <ComboBox id="recipientComboBox" 
                    placeholder="Please select recipient"
                    width="100%"
                    class="sapUiMediumMarginBottom">
                    <items>
                        <core:Item key="I761557" text="I761557"/>
                        <core:Item key="I761558" text="I761558"/>
                        <core:Item key="I761559" text="I761559"/>
                    </items>
                </ComboBox>
                
                <!-- Comment -->
                <Label text="Comment:" required="true" class="sapUiTinyMarginBottom"/>
                <TextArea id="notificationComment" 
                    rows="6"
                    width="100%"
                    placeholder="Please enter comment..."
                    class="sapUiMediumMarginBottom"/>
            </VBox>
        </content>
        <beginButton>
            <Button text="Send" 
                type="Emphasized" 
                press="onConfirmSendNotification"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" 
                press="onCancelSendNotification"/>
        </endButton>
    </Dialog>

</mvc:View>
