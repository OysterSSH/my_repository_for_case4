{
  "_version": "1.76.0",
  "sap.app": {
    "id": "finprecheck",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.19.3",
      "toolsId": "353f46dd-62a0-4f4b-9661-922b20021527"
    },
    "crossNavigation": {
      "inbounds": {
        "finprecheck-show": {
          "semanticObject": "finprecheck",
          "action": "show",
          "title": "{{finprecheck-show.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.142.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "finprecheck.i18n.i18n"
        }
      },
      "checkResults": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/CheckResults.json"
      },
      "cogiResultItems": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/COGIResultItems.json"
      },
      "otherCheckDetails": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/OtherCheckDetails.json"
      },
      "fixedAssetDepreciationItems": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/FixedAssetDepreciationItems.json"
      }      
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "finprecheck.view",
        "async": true,
        "viewPath": "finprecheck.view"
      },
      "routes": [
        {
          "name": "Routefin-precheck",
          "pattern": ":?query:",
          "target": [
            "Targetfin-precheck"
          ]
        },
        {
          "name": "cogiList",
          "pattern": "cogi/{checkItem}",
          "target": ["cogiList"]
        },
        {
          "name": "costCenterAnalysis",
          "pattern": "costCenterAnalysis",
          "target": ["costCenterAnalysis"]
        },
        {
          "name": "fixedAssetDepreciationList",
          "pattern": "fixedAssetDepreciation/{checkItem}",
          "target": ["fixedAssetDepreciationList"]
        }      
      ],
      "targets": {
        "Targetfin-precheck": {
          "id": "fin-precheck",
          "name": "fin-precheck"
        },
        "cogiList": {
          "id": "cogiList",
          "name": "COGIList",
          "level": 1
        },
        "costCenterAnalysis": {
          "id": "costCenterAnalysis",
          "name": "CostCenterAnalysis",
          "level": 1
        },
        "fixedAssetDepreciationList": {
          "id": "fixedAssetDepreciationList",
          "name": "FixedAssetDepreciationList",
          "level": 1
        }
      }
    },
    "rootView": {
      "viewName": "finprecheck.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "finprecheck"
  }
}
